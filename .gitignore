# 個人化資源(聲音樣本例外,收在 voices/samples/)
voices/*.wav
voices/*.mp3
photos/*.png
photos/*.jpg
photos/*.jpeg

# 上傳的 PDF 可能含版權考題,不追蹤
pdfs

# slide_ingest.py 渲染出來的 PNG 可重生成,不追蹤(避免 repo 膨脹)
slides

# Gemini 錯誤調試輸出
gemini_error_*.txt
# Gemini raw output / debug 暫存 — 寫出來看 prompt 結構用, 不該 commit
gemini_raw_output.txt
# UI 截圖 / 一次性 cairosvg test — 放 docs/ 內才該 commit
exams_temp.html
test_svg.png
test_svg.py
ui_*.png

# OAuth 憑證 (publish.py 會用到)
client_secret*.json
youtube_token.json

# Python / Claude 快取
__pycache__/
*.pyc
*.pyo
work/
output/

# Server (PR-2a) runtime: job state + artifacts 不追蹤
jobs/

# React UI (PR-3e) build / deps
web/node_modules/
web/dist/
web/.vite/
web/*.tsbuildinfo
web/vite.config.d.ts
web/vite.config.js

# Claude Code harness 運行狀態 (worktrees / scheduled_tasks.lock / 其他 session state)
# 規則: .claude/ 內部全部不追蹤, 但下面這幾個專案層級資產要追蹤:
# - commands/  專案 slash commands (給 team 共用, 例 /advance)
# - skills/    專案 skills (給 team 共用, 例 pdf-to-video)
.claude/*
!.claude/commands/
!.claude/skills/

# 個人 TTS 設定 — server / smoke test 會改它, 容易誤 commit (踩過兩次)。
# 範本見 tts_config.example.json, 第一次 clone 後 copy 即可。
tts_config.json

# 環境變數 — 含 GEMINI_API_KEY 等 secrets, 絕不 commit
# 範本見 .env.example
.env

# ideate 個人設定 (watched_folders 是本機路徑, 不該 commit)
# 範本見 ideate_config.example.yaml
ideate_config.yaml
