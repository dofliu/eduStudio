voices/*.wav
voices/*.mp3
photos/*.png
photos/*.jpg
photos/*.jpeg

# 上傳的 PDF 可能含版權考題,不追蹤
pdfs

# slide_ingest.py 渲染出來的 PNG 可重生成,不追蹤(避免 repo 膨脹)
slides

# Gemini 錯誤調試輸出
gemini_error_*.txt
# Gemini raw output / debug 暫存 — 寫出來看 prompt 結構用, 不該 commit
gemini_raw_output.txt
# UI 截圖 / 一次性 cairosvg test — 放 docs/ 內才該 commit
exams_temp.html
test_svg.png
test_svg.py
ui_*.png

# OAuth 憑證 (publish.py 會用到)
client_secret*.json
youtube_token.json

# Python / Claude 快取
__pycache__/
*.pyc
*.pyo
work/
output/

# Server (PR-2a) runtime: job state + artifacts 不追蹤
jobs/

# React UI (PR-3e) build / deps
web/node_modules/
web/dist/
web/.vite/
web/*.tsbuildinfo
web/vite.config.d.ts
web/vite.config.js

# Claude Code harness 運行狀態 (worktrees / scheduled_tasks.lock / 其他 session state)
# 規則: .claude/ 內部全部不追蹤, 但下面這幾個專案層級資產要追蹤:
# - commands/  專案 slash commands (給 team 共用, 例 /advance)
# - skills/    專案 skills (給 team 共用, 例 pdf-to-video)
.claude/*
!.claude/commands/
!.claude/skills/

# 個人 TTS 設定 — server / smoke test 會改它, 容易誤 commit (踩過兩次)。
# 範本見 tts_config.example.json, 第一次 clone 後 copy 即可。
tts_config.json

# 環境變數 — 含 GEMINI_API_KEY 等 secrets, 絕不 commit
# 範本見 .env.example
.env

# ideate 個人設定 — iter 27 已改 ad-hoc 模式 (UI 按鈕直接接 path), 不再用 yaml
# 仍 ignore 防舊版設定誤 commit
ideate_config.yaml

# iter 41/44: intro normalize cache (audio 轉檔結果), 由 video_concat.py
# 依 intro mtime 自動產生 / invalidate, 不該 commit (可重建 + 跨機器路徑不同)
# iter 98: 用 assets/* 不是 assets/, 才能用 !assets/icon_library/ 例外
# (git 規則: 一旦目錄整個被 ignore, 內檔不可再 re-include)
assets/*
!assets/icon_library/

# iter 97: 本機產物 / 備份 / log — 不該進 repo
# TTS 樣本 (tests/trst.py 跑出來給用戶試聽選聲音)
tts_samples/
# scriptor Gemini call 失敗時的 raw output dump
_scriptor_errors/
# 一次性備份 zip / rar (打包整個 web/ 或 repo)
*.zip
*.rar
# 影片產物 (outro / demo / intro mp4) 不該追蹤, 走 OUTPUT_DIR 流程
docs/*.mp4

# SONG track: demucs 分人聲輸出 (vocals.wav / no_vocals.wav, 數百 MB scratch)
# 由 demucs 從歌曲音檔重生, 不該 commit
separated/

# SONG M0b 本機測試輸出 (劉老師跑 tools/song_mv.py 產的 song.json / srt / mp4)
# 是個人歌曲測試資料 (含版權音檔), 不進 repo; 範例見 tools/song_mv.py docstring
tools/song.json
tools/*.srt
tools/*.mp4
